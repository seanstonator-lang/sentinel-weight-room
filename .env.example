# Set a unique password of at least 16 characters. Never commit .env.
SENTINEL_PASSWORD=
# Exact browser origin, no trailing path. Use HTTPS for actual records.
PUBLIC_ORIGIN=http://raspberrypi.local:3000
# LAN testing only. Keep loopback binding with an HTTPS reverse proxy.
BIND_ADDRESS=127.0.0.1
COOKIE_SECURE=true
